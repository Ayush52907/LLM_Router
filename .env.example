# Carbon- and Latency-Aware Agent Workflow Scheduler — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env.

# ──────────────────────────────────────────────────────────────────
# TypeSafe AI (Jev) — https://api.typesafe.ai
# ──────────────────────────────────────────────────────────────────
TYPESAFE_API_KEY=

# ──────────────────────────────────────────────────────────────────
# Google Gemini API — https://aistudio.google.com/app/apikey
# ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ──────────────────────────────────────────────────────────────────
# Vercel AI Gateway (optional — for cloud LLM routing)
# ──────────────────────────────────────────────────────────────────
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh

# ──────────────────────────────────────────────────────────────────
# Electricity Maps — https://api.electricitymap.org
# Free tier required. Zone used: IN-KA (Bengaluru)
# ──────────────────────────────────────────────────────────────────
ELECTRICITY_MAPS_API_KEY=

# ──────────────────────────────────────────────────────────────────
# Ollama — local LLM inference
# ──────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ──────────────────────────────────────────────────────────────────
# Python sidecar (EcoLogits + CodeCarbon)
# ──────────────────────────────────────────────────────────────────
SIDECAR_BASE_URL=http://localhost:8000

# ──────────────────────────────────────────────────────────────────
# Orchestrator
# ──────────────────────────────────────────────────────────────────
ORCHESTRATOR_PORT=3001
DATABASE_PATH=./db.sqlite

# ──────────────────────────────────────────────────────────────────
# Feature flags
# ──────────────────────────────────────────────────────────────────
# Set to "mock" to use deterministic mocks for Jev, Electricity Maps, Sidecar
# Set to "live" to use real APIs (requires all keys above)
JEV_MODE=mock
ELECTRICITY_MAPS_MODE=mock
SIDECAR_MODE=mock

# Local grid zone (used for Electricity Maps and local carbon computation)
LOCAL_GRID_ZONE=IN-KA

# ──────────────────────────────────────────────────────────────────
# Email / OTP Authentication
# ──────────────────────────────────────────────────────────────────
# Sender email address (Gmail or any SMTP provider)
EMAIL_FROM=your@gmail.com

# Gmail App Password (NOT your main password — generate at myaccount.google.com/apppasswords)
# Leave blank to run in dev mode: OTP is printed to the orchestrator console instead.
EMAIL_PASS=

# Next.js public URL — used by the dashboard to reach the orchestrator
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:3001
